DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
JWT_SECRET=
JWT_EXPIRES_IN=8h
GOOGLE_CLIENT_ID=
# Sign in with Apple: Services ID de Apple Developer (usado como audience al
# verificar el identityToken). Mientras no esté seteada, /api/auth/apple
# responde 503 y el botón de Apple del login queda inactivo.
APPLE_CLIENT_ID=
PORT=3001
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=latribu-files
GOOGLE_VISION_API_KEY=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
NOTIFICATION_FROM=no-reply@latribu.com
ADMIN_NOTIFICATION_EMAIL=
# Origen del front nuevo — usado solo para redirigir el navegador de vuelta
# tras el callback OAuth de wearables (Garmin/WHOOP/Oura/Polar).
FRONTEND_URL=http://localhost:3000
# Dispositivos y Laboratorios (módulo Mentoring): WHOOP/Oura/Polar tienen
# integración OAuth real; mientras no se configuren estas variables, el botón
# de conectar cada dispositivo responde 503 y queda inactivo en el front.
# Garmin no tiene servicio implementado todavía (ver docs/errors-resueltos.md).
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:3003/api/wearable/whoop/callback
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=http://localhost:3003/api/wearable/oura/callback
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
# Pago digital de membresías (pago único, no suscripción). STRIPE_SECRET_KEY
# es la clave secreta modo test/live del dashboard de Stripe; mientras no
# esté seteada, crear un PaymentIntent falla con un error explícito.
# STRIPE_WEBHOOK_SECRET sale de configurar el endpoint del webhook
# (/api/stripe/webhook) en el dashboard de Stripe — sin ella no se puede
# verificar la firma y el webhook rechaza todo con 400.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Wompi (Colombia) — proveedor de pago activo hoy (sandbox: llaves pub_test_/
# prv_test_ del dashboard de Wompi). WOMPI_PUBLIC_KEY viaja al frontend en la
# respuesta del checkout (no es secreta). WOMPI_INTEGRITY_SECRET firma cada
# cobro nuevo; WOMPI_EVENTS_SECRET verifica el checksum del webhook
# (/api/wompi/webhook, configurado en el dashboard de Wompi) — sin ellas, el
# checkout/webhook de Wompi responden 503/400 en vez de romper el servidor.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Margen aplicado sobre la TRM oficial al convertir el precio de referencia
# de Club Elite (USD) a COP para cobrar por Wompi (ver trm.service.ts).
# Decimal, ej. 0.03 = 3%. Si no está seteada, el código usa 0.03 por defecto.
WOMPI_ELITE_MARGIN=0.03
