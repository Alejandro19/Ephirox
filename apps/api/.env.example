DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
JWT_SECRET=
JWT_EXPIRES_IN=8h
GOOGLE_CLIENT_ID=
# Sign in with Apple: Services ID de Apple Developer (usado como audience al
# verificar el identityToken). Mientras no esté seteada, /api/auth/apple
# responde 503 y el botón de Apple del login queda inactivo.
APPLE_CLIENT_ID=
PORT=3001
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=latribu-files
GOOGLE_VISION_API_KEY=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
NOTIFICATION_FROM=no-reply@latribu.com
ADMIN_NOTIFICATION_EMAIL=
